# Production Environment Variables
# Copy this to .env.production and fill in the values

# Database (password used by docker-compose)
POSTGRES_PASSWORD=your-secure-password-here

# JWT Authentication (REQUIRED - change in production!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRATION_TIME=90D
REFRESH_TOKEN_EXPIRATION_TIME=200D
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# SIWE (Sign-In with Ethereum)
NONCE_EXPIRE_TIME_MINUTES=5
SIWE_DOMAIN=com.cstralpt.takumipay
SIWE_URI=takumipay://wallet-auth
SIWE_STATEMENT=Sign in to TakumiPay

# Blockchain
CHAIN_ID=1
MIN_CONFIRMATIONS=12

# CORS (comma-separated origins)
CORS_ORIGINS=https://app.takumipay.xyz,takumipay://
CORS_CREDENTIALS=true

# Vendor API
VCGAMERS_SECRET=your-vcgamers-secret

# Core Payment API (if applicable)
CORE_PAYMENT_API_URL=https://your-core-payment-api.com
CORE_PAYMENT_API_TIMEOUT=60000
CORE_PAYMENT_API_RETRY_COUNT=3
