// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  SUBCATEGORY
  MAINCATEGORY
}

model Category {
  id             String           @id @default(ulid())
  name           String           @unique
  description    String?
  imageUrl       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Product        Product[]
  categoryType   CategoryType
  ProductVariant ProductVariant[]
}

model Product {
  id          String              @id @default(ulid())
  name        String
  description String?
  imageUrl    String?
  code        String              @unique
  category    Category            @relation(fields: [categoryId], references: [id])
  categoryId  String
  isActive    Boolean             @default(true)
  isVoucher   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  variants    ProductVariant[]
  inputFields ProductInputField[]

  @@index([code])
}

enum InputFieldType {
  TEXT
  NUMBER
  EMAIL
  OPTION
  DATE
}

model ProductInputField {
  id        String   @id @default(ulid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  forms     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id               String            @id @default(ulid())
  name             String
  description      String?
  variantCode      String            @unique
  product          Product           @relation(fields: [productId], references: [id])
  productId        String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ProductPrice     ProductPrice[]
  Purchase         Purchase[]
  BookingOrder     BookingOrder[]
  pointRedemptions PointRedemption[]
  flashSales       FlashSale[]
  subCategory      Category?         @relation(fields: [subCategoryId], references: [id])
  subCategoryId    String?

  @@index([variantCode])
}

model Vendor {
  id           String         @id @default(ulid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  VendorAPI    VendorAPI[]
  ProductPrice ProductPrice[]
}

model User {
  id                String               @id @default(ulid())
  walletAddress     String?              @unique
  email             String?              @unique
  username          String?              @unique
  password          String?
  name              String?
  profileImage      String?
  authProvider      AuthProvider
  socialId          String?
  role              UserRole             @default(USER)
  status            UserStatus           @default(ACTIVE)
  permissions       Json?
  lastLoginAt       DateTime?
  loginAttempts     Int                  @default(0)
  lockedUntil       DateTime?
  transactions      TransactionHistory[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  Region            Region?              @relation(fields: [regionId], references: [id])
  regionId          String?
  ApiKey            ApiKey[]
  auditLogs         AdminAuditLog[]
  dappFavorites     UserDappFavorite[]
  addressBook       AddressBook[]
  pointBalance      PointBalance?
  pointTransactions PointTransaction[]
  pointRedemptions  PointRedemption[]
  nftAssets         NftAsset[]

  @@unique([authProvider, socialId])
  @@index([role])
  @@index([status])
  @@index([email])
  @@index([username])
}

model Blockchain {
  id                String             @id @default(ulid())
  name              String             @unique
  chainId           Int?               @unique
  chainSlug         String?            @unique
  rpcUrl            String
  blockExplorer     String
  isEVM             Boolean            @default(true)
  isActive          Boolean            @default(true)
  tokens            Token[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  SmartContract     SmartContract[]
  isTestnet         Boolean            @default(false)
  pointTransactions PointTransaction[]
  nftAssets         NftAsset[]
}

model Token {
  id                 String                 @id @default(ulid())
  name               String
  symbol             String
  decimals           Int
  blockchain         Blockchain             @relation(fields: [blockchainId], references: [id])
  blockchainId       String
  contractAddress    String?
  logoUrl            String?
  isStablecoin       Boolean                @default(false)
  isActive           Boolean                @default(true)
  isNativeCurrency   Boolean                @default(false)
  peggedCurrency     String?
  transactions       TransactionHistory[]
  regionAvailability RegionAvailableToken[]
  pointTransactions  PointTransaction[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([blockchainId, contractAddress])
}

model ProductPrice {
  id               String            @id @default(ulid())
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])
  productVariantId String
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  vendorId         String
  realValue        Decimal
  priceFromVendor  Decimal
  sellPrice        Decimal
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  BookingOrder     BookingOrder[]
  pointRedemptions PointRedemption[]
  flashSales       FlashSale[]
  currency         String

  @@index([productVariantId])
  @@index([vendorId])
  @@index([productVariantId, vendorId, isActive])
}

// TimescaleDB Hypertable - optimized for millions of transactions
// Composite PK required for hypertable partitioning on createdAt
// Note: No FK relation to Purchase — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model TransactionHistory {
  id               String            @default(ulid())
  user             User              @relation(fields: [userId], references: [id])
  userId           String
  token            Token             @relation(fields: [tokenId], references: [id])
  tokenId          String
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal
  amountInFiat     Decimal?
  fiatCurrency     String?
  txHash           String?
  senderAddress    String?
  recipientAddress String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@id([id, createdAt])
  @@unique([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([txHash])
}

// Note: transactionId/transactionCreatedAt reference the TransactionHistory
// hypertable but have no DB-level FK — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model Purchase {
  id                   String         @id @default(ulid())
  transactionId        String
  transactionCreatedAt DateTime
  productVariant       ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId     String
  bookingOrder         BookingOrder   @relation(fields: [bookingOrderId], references: [id])
  bookingOrderId       String         @unique
  status               PurchaseStatus @default(PENDING)
  vendorResponse       Json?
  vendorStatusResponse Json?
  vendorRefId          String?
  refId                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([transactionId, transactionCreatedAt])
  @@index([refId])
}

// TimescaleDB Hypertable - already configured with 1-day chunk intervals
model ExchangeRate {
  id               Int            @default(autoincrement())
  fromCurrency     String
  toCurrency       String
  rate             Decimal
  sourceProvider   ExchangeSource @relation(fields: [sourceProviderId], references: [id])
  sourceProviderId String
  region           String?
  provider         String?
  markup           Decimal?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@id([id, createdAt])
  @@unique([fromCurrency, toCurrency, region, provider, createdAt])
}

model ExchangeSource {
  id             String         @id @default(ulid())
  name           String         @unique
  description    String?
  apiEndpoint    String?
  apiKey         String?
  updateInterval Int            @default(3600)
  priority       Int            @default(1)
  isActive       Boolean        @default(true)
  lastUpdated    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exchangeRates  ExchangeRate[]
}

model VendorAPI {
  id        String   @id @default(ulid())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  vendorId  String
  baseUrl   String
  apiKey    String
  apiSecret String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmartContract {
  id           String      @id @default(ulid())
  name         String
  blockchain   Blockchain  @relation(fields: [blockchainId], references: [id])
  blockchainId String
  address      String
  abi          ContractABI @relation(fields: [abiId], references: [id])
  abiId        String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([blockchainId, address])
}

model ContractABI {
  id          String          @id @default(ulid())
  name        String          @unique
  description String?
  version     String?
  abi         Json
  isVerified  Boolean         @default(false)
  contracts   SmartContract[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
  REFUNDED
  TRANSFERRED
}

enum PurchaseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuthProvider {
  WALLET
  GOOGLE
  APPLE
  EMAIL
  ADMIN_CREDENTIALS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Region {
  id                String   @id @default(ulid())
  code              String   @unique
  name              String
  currencyCode      String
  isActive          Boolean  @default(true)
  hasKYCRequirement Boolean  @default(false)
  taxRate           Decimal  @default(0)
  supportEmail      String?
  supportPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users           User[]
  availableTokens RegionAvailableToken[]
}

model RegionAvailableToken {
  id                 String   @id @default(ulid())
  region             Region   @relation(fields: [regionId], references: [id])
  regionId           String
  token              Token    @relation(fields: [tokenId], references: [id])
  tokenId            String
  isActive           Boolean  @default(true)
  minAmount          Decimal?
  maxAmount          Decimal?
  processingFee      Decimal  @default(0)
  networkFeeEstimate Decimal?
  isDefault          Boolean  @default(false)
  regulatoryNotes    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([regionId, tokenId])
}

enum BookingStatus {
  PENDING
  EXPIRED
  EXECUTED
  CANCELLED
}

enum ReferenceIdStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReferenceId {
  id        String            @id @default(ulid())
  refId     String            @unique
  status    ReferenceIdStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([refId])
  @@index([status])
}

model BookingOrder {
  id               String         @id @default(ulid())
  walletAddress    String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  productPrice     ProductPrice   @relation(fields: [productPriceId], references: [id])
  productPriceId   String
  customerInfo     Json?
  payment          Json
  exchangeRate     Json
  status           BookingStatus  @default(PENDING)
  expiresAt        DateTime
  purchase         Purchase?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([walletAddress])
  @@index([walletAddress, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

enum ApiKeyType {
  SMART_CONTRACT
  MOBILE_APP
  WEB_APP
  THIRD_PARTY
  INTERNAL
  ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id          String       @id @default(ulid())
  name        String
  description String?
  keyValue    String       @unique
  type        ApiKeyType
  status      ApiKeyStatus @default(ACTIVE)
  permissions Json?
  rateLimit   Int?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int          @default(0)
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdById String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([keyValue])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
}

// TimescaleDB Hypertable - optimized for audit log queries at scale
// Composite PK required for hypertable partitioning on createdAt
model AdminAuditLog {
  id          String   @default(ulid())
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  adminUserId String
  action      String
  resource    String
  resourceId  String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@id([id, createdAt])
  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resource, createdAt(sort: Desc)])
}

model DappCategory {
  id          String   @id @default(ulid())
  name        String   @unique
  description String?
  iconUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dapps       Dapp[]

  @@index([name])
  @@index([isActive])
}

model Dapp {
  id          String             @id @default(ulid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String
  category    DappCategory       @relation(fields: [categoryId], references: [id])
  categoryId  String
  isPopular   Boolean            @default(false)
  isSponsor   Boolean            @default(false)
  isHighlight Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  bgColor     String?
  favorites   UserDappFavorite[]

  @@index([categoryId])
  @@index([isPopular])
  @@index([isSponsor])
  @@index([isHighlight])
  @@index([isActive])
  @@index([createdAt])
}

model UserDappFavorite {
  id        String   @id @default(ulid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  dapp      Dapp     @relation(fields: [dappId], references: [id])
  dappId    String
  createdAt DateTime @default(now())

  @@unique([userId, dappId])
  @@index([userId])
  @@index([dappId])
}

model AddressBook {
  id        String   @id @default(ulid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String
  address   String
  ensName   String?
  notes     String?
  isEvm     Boolean  @default(true)
  chainName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address])
  @@index([userId])
  @@index([userId, label])
}

// ── Point System ────────────────────────────────────────────────────────────

model PointBalance {
  id        String   @id @default(ulid())
  userId    String   @unique
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// TimescaleDB Hypertable - optimized for high-volume point ledger
// Composite PK required for hypertable partitioning on createdAt
// Note: No FK relation to PointRedemption — TimescaleDB hypertables cannot be
// the target of FK constraints (chunks live in _timescaledb_internal).
// Referential integrity is enforced at the application level.
model PointTransaction {
  id            String               @default(ulid())
  userId        String
  type          PointTransactionType
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt

  // Deposit fields (populated for DEPOSIT type)
  // Note: refId/txHash are not @unique — TimescaleDB hypertables disallow unique
  // indexes without the partitioning column. Uniqueness enforced at app level.
  refId           String?
  txHash          String?
  tokenId         String?
  blockchainId    String?
  contractAddress String?
  tokenAmount     Decimal? @db.Decimal(36, 18)
  pointRate       Decimal? @db.Decimal(18, 8)

  // Redemption fields (populated for SPEND/REFUND type)
  referenceType String?
  referenceId   String?

  status    PointTransactionStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime               @default(now())

  user       User        @relation(fields: [userId], references: [id])
  token      Token?      @relation(fields: [tokenId], references: [id])
  blockchain Blockchain? @relation(fields: [blockchainId], references: [id])

  @@id([id, createdAt])
  @@unique([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([txHash])
  @@index([refId])
}

model PointPriceConfig {
  id        String   @id @default(ulid())
  baseRate  Decimal  @db.Decimal(18, 8)
  currency  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([currency, isActive])
  @@index([isActive, createdAt(sort: Desc)])
}

enum PointTransactionType {
  DEPOSIT
  SPEND
  REFUND
  BONUS
}

enum PointTransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
}

// Note: pointTransactionId/pointTransactionCreatedAt reference the PointTransaction
// hypertable but have no DB-level FK — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model PointRedemption {
  id                        String           @id @default(ulid())
  userId                    String
  pointTransactionId        String
  pointTransactionCreatedAt DateTime
  productVariantId          String
  productPriceId            String
  customerInfo              Json?
  status                    RedemptionStatus @default(PENDING)
  pointsSpent               BigInt
  vendorResponse            Json?
  vendorRefId               String?
  metadata                  Json?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  productPrice   ProductPrice   @relation(fields: [productPriceId], references: [id])

  @@unique([pointTransactionId, pointTransactionCreatedAt])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

enum RedemptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model FlashSale {
  id                 String   @id @default(ulid())
  productVariantId   String
  productPriceId     String
  discountedPrice    Decimal  @db.Decimal(18, 2)
  currency           String
  startsAt           DateTime
  endsAt             DateTime
  maxRedemptions     Int?
  currentRedemptions Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  productPrice   ProductPrice   @relation(fields: [productPriceId], references: [id])

  @@index([isActive, startsAt, endsAt])
  @@index([productVariantId])
}

// ── NFT Asset Management ────────────────────────────────────────────────────

enum NftTokenType {
  ERC721
  ERC1155
}

model NftAsset {
  id              String       @id @default(ulid())
  userId          String
  walletAddress   String
  contractAddress String
  tokenId         String
  blockchainId    String
  tokenType       NftTokenType @default(ERC721)
  name            String?
  description     String?
  imageUrl        String?
  tokenUri        String?
  attributes      Json?
  isOwned         Boolean      @default(true)
  lastVerifiedAt  DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  blockchain Blockchain @relation(fields: [blockchainId], references: [id])

  @@unique([walletAddress, contractAddress, tokenId, blockchainId])
  @@index([userId, isOwned])
  @@index([contractAddress])
  @@index([blockchainId])
}
