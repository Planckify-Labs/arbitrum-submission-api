// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  SUBCATEGORY
  MAINCATEGORY
}

model Category {
  id             String           @id @default(ulid())
  name           String           @unique
  description    String?
  imageUrl       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Product        Product[]
  categoryType   CategoryType
  ProductVariant ProductVariant[]
}

model Product {
  id          String              @id @default(ulid())
  name        String
  description String?
  imageUrl    String?
  code        String              @unique
  category    Category            @relation(fields: [categoryId], references: [id])
  categoryId  String
  isActive    Boolean             @default(true)
  isVoucher   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  variants    ProductVariant[]
  inputFields ProductInputField[]

  @@index([code])
}

enum InputFieldType {
  TEXT
  NUMBER
  EMAIL
  OPTION
  DATE
}

model ProductInputField {
  id        String   @id @default(ulid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  forms     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id               String            @id @default(ulid())
  name             String
  description      String?
  variantCode      String            @unique
  product          Product           @relation(fields: [productId], references: [id])
  productId        String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ProductPrice     ProductPrice[]
  Purchase         Purchase[]
  BookingOrder     BookingOrder[]
  pointRedemptions PointRedemption[]
  flashSales       FlashSale[]
  subCategory      Category?         @relation(fields: [subCategoryId], references: [id])
  subCategoryId    String?

  @@index([variantCode])
}

model Vendor {
  id           String         @id @default(ulid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  VendorAPI    VendorAPI[]
  ProductPrice ProductPrice[]
}

model User {
  id                 String               @id @default(ulid())
  walletAddress      String?              @unique
  walletAddressLower String?              @unique
  email              String?              @unique
  username           String?              @unique
  password           String?
  name               String?
  profileImage       String?
  authProvider       AuthProvider
  socialId           String?
  role               UserRole             @default(USER)
  status             UserStatus           @default(ACTIVE)
  permissions        Json?
  lastLoginAt        DateTime?
  loginAttempts      Int                  @default(0)
  lockedUntil        DateTime?
  transactions       TransactionHistory[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Region             Region?              @relation(fields: [regionId], references: [id])
  regionId           String?
  ApiKey             ApiKey[]
  auditLogs          AdminAuditLog[]
  dappFavorites      UserDappFavorite[]
  addressBook        AddressBook[]
  pointBalance       PointBalance?
  pointTransactions  PointTransaction[]
  pointRedemptions   PointRedemption[]
  nftAssets          NftAsset[]

  // UMKM USDC payout rails (§6.6)
  merchant              Merchant?
  paymentIntentsAsPayer PaymentIntent[]  @relation("PaymentIntentPayer")
  gatewayDeposits       GatewayDeposit[]

  pushTokens            PushToken[]

  @@unique([authProvider, socialId])
  @@index([role])
  @@index([status])
  @@index([email])
  @@index([username])
}

/// Expo push notification tokens. One row per (user, device) — the
/// Expo token rotates per app install, so we upsert by token. Used by
/// the strategies auto-compound watcher and the payout-receipt push
/// (umkm-usdc-payout-spec.md §6.3).
model PushToken {
  token         String   @id
  userId        String
  walletAddress String? // optional convenience for wallet-scoped pushes
  platform      String // "ios" | "android" | "web"
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([walletAddress])
}

model Blockchain {
  id                String             @id @default(ulid())
  name              String             @unique
  chainId           Int?               @unique
  chainSlug         String?            @unique
  rpcUrl            String
  blockExplorer     String
  isEVM             Boolean            @default(true)
  isActive          Boolean            @default(true)
  tokens            Token[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  SmartContract     SmartContract[]
  isTestnet         Boolean            @default(false)
  pointTransactions PointTransaction[]
  nftAssets         NftAsset[]

  // Onchain settlement coordinates (Phase 1)
  takumiWalletContract String?
  quoteSignerAddress   String?
  minConfirmations     Int?

  // Circle Gateway / Paymaster / x402 coordinates (§7.1). Nullable — Gateway is
  // not deployed on every chain, and Arc itself has no Paymaster (USDC=gas).
  // Populated by ops via seed/SQL; x402_* columns are also rewritten by the
  // boot-time `GET /gateway/v1/x402/supported` refresh (§6.5).
  gatewayWalletContract String?
  gatewayMinterContract String?
  paymasterAddress      String?
  x402DomainName        String?
  x402DomainVersion     String?
  x402VerifyingContract String?
  x402FacilitatorUrl    String?

  // ERC-4337 bundler URL (task 37 — `POST /v1/userop/submit`). Currently
  // carries the provider API key in the query string (`?apikey=…`). This
  // column is SERVER-ONLY — must never be serialized through the public
  // `GET /v1/blockchains` endpoint (task 21). See
  // `docs/security_review_needed.md §4` for the planned migration to split
  // the URL from the key and move the key to a secrets manager.
  bundlerUrl String?

  // Solana-specific fields (Solana contract integration)
  solanaCluster      String?
  takumiPayProgramId String?
}

model Token {
  id                 String                 @id @default(ulid())
  name               String
  symbol             String
  decimals           Int
  blockchain         Blockchain             @relation(fields: [blockchainId], references: [id])
  blockchainId       String
  contractAddress    String?
  logoUrl            String?
  isStablecoin       Boolean                @default(false)
  isActive           Boolean                @default(true)
  isNativeCurrency   Boolean                @default(false)
  peggedCurrency     String?
  transactions       TransactionHistory[]
  regionAvailability RegionAvailableToken[]
  pointTransactions  PointTransaction[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  // Onchain settlement (Phase 1)
  isPaymentEnabled Boolean @default(false)
  platformFeeBps   Int     @default(0)

  paymentIntents PaymentIntent[]

  @@unique([blockchainId, contractAddress])
}

model ProductPrice {
  id               String            @id @default(ulid())
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])
  productVariantId String
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  vendorId         String
  realValue        Decimal
  priceFromVendor  Decimal
  sellPrice        Decimal
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  BookingOrder     BookingOrder[]
  pointRedemptions PointRedemption[]
  flashSales       FlashSale[]
  currency         String

  @@index([productVariantId])
  @@index([vendorId])
  @@index([productVariantId, vendorId, isActive])
}

// TimescaleDB Hypertable - optimized for millions of transactions
// Composite PK required for hypertable partitioning on createdAt
// Note: No FK relation to Purchase — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model TransactionHistory {
  id               String            @default(ulid())
  user             User              @relation(fields: [userId], references: [id])
  userId           String
  token            Token             @relation(fields: [tokenId], references: [id])
  tokenId          String
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal
  amountInFiat     Decimal?
  fiatCurrency     String?
  txHash           String?
  senderAddress    String?
  recipientAddress String?
  merchantName     String?
  paymentIntentId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@id([id, createdAt])
  @@unique([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([txHash])
  @@index([paymentIntentId])
}

// Note: transactionId/transactionCreatedAt reference the TransactionHistory
// hypertable but have no DB-level FK — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model Purchase {
  id                   String         @id @default(ulid())
  transactionId        String
  transactionCreatedAt DateTime
  productVariant       ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId     String
  bookingOrder         BookingOrder   @relation(fields: [bookingOrderId], references: [id])
  bookingOrderId       String         @unique
  status               PurchaseStatus @default(PENDING)
  vendorResponse       Json?
  vendorStatusResponse Json?
  vendorRefId          String?
  refId                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([transactionId, transactionCreatedAt])
  @@index([refId])
}

// TimescaleDB Hypertable - already configured with 1-day chunk intervals
model ExchangeRate {
  id               Int            @default(autoincrement())
  fromCurrency     String
  toCurrency       String
  rate             Decimal
  sourceProvider   ExchangeSource @relation(fields: [sourceProviderId], references: [id])
  sourceProviderId String
  region           String?
  provider         String?
  markup           Decimal?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@id([id, createdAt])
  @@unique([fromCurrency, toCurrency, region, provider, createdAt])
}

model ExchangeSource {
  id             String         @id @default(ulid())
  name           String         @unique
  description    String?
  apiEndpoint    String?
  apiKey         String?
  updateInterval Int            @default(3600)
  priority       Int            @default(1)
  isActive       Boolean        @default(true)
  lastUpdated    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exchangeRates  ExchangeRate[]
}

model VendorAPI {
  id        String   @id @default(ulid())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  vendorId  String
  baseUrl   String
  apiKey    String
  apiSecret String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmartContract {
  id           String     @id @default(ulid())
  name         String
  blockchain   Blockchain @relation(fields: [blockchainId], references: [id])
  blockchainId String
  address      String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([blockchainId, address])
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
  REFUNDED
  TRANSFERRED
}

enum PurchaseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuthProvider {
  WALLET
  GOOGLE
  APPLE
  EMAIL
  ADMIN_CREDENTIALS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Region {
  id                String   @id @default(ulid())
  code              String   @unique
  name              String
  currencyCode      String
  isActive          Boolean  @default(true)
  hasKYCRequirement Boolean  @default(false)
  taxRate           Decimal  @default(0)
  supportEmail      String?
  supportPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users           User[]
  availableTokens RegionAvailableToken[]
}

model RegionAvailableToken {
  id                 String   @id @default(ulid())
  region             Region   @relation(fields: [regionId], references: [id])
  regionId           String
  token              Token    @relation(fields: [tokenId], references: [id])
  tokenId            String
  isActive           Boolean  @default(true)
  minAmount          Decimal?
  maxAmount          Decimal?
  processingFee      Decimal  @default(0)
  networkFeeEstimate Decimal?
  isDefault          Boolean  @default(false)
  regulatoryNotes    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([regionId, tokenId])
}

enum BookingStatus {
  PENDING
  EXPIRED
  EXECUTED
  CANCELLED
}

enum ReferenceIdStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReferenceId {
  id        String            @id @default(ulid())
  refId     String            @unique
  status    ReferenceIdStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([refId])
  @@index([status])
}

model BookingOrder {
  id               String         @id @default(ulid())
  walletAddress    String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  productPrice     ProductPrice   @relation(fields: [productPriceId], references: [id])
  productPriceId   String
  customerInfo     Json?
  payment          Json
  exchangeRate     Json
  status           BookingStatus  @default(PENDING)
  expiresAt        DateTime
  purchase         Purchase?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([walletAddress])
  @@index([walletAddress, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

enum ApiKeyType {
  SMART_CONTRACT
  MOBILE_APP
  WEB_APP
  THIRD_PARTY
  INTERNAL
  ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id          String       @id @default(ulid())
  name        String
  description String?
  keyValue    String       @unique
  type        ApiKeyType
  status      ApiKeyStatus @default(ACTIVE)
  permissions Json?
  rateLimit   Int?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int          @default(0)
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdById String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([keyValue])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
}

// TimescaleDB Hypertable - optimized for audit log queries at scale
// Composite PK required for hypertable partitioning on createdAt
model AdminAuditLog {
  id          String   @default(ulid())
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  adminUserId String
  action      String
  resource    String
  resourceId  String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@id([id, createdAt])
  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resource, createdAt(sort: Desc)])
}

model DappCategory {
  id          String   @id @default(ulid())
  name        String   @unique
  description String?
  iconUrl     String?
  appearance  Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dapps       Dapp[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

model Dapp {
  id          String             @id @default(ulid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String
  category    DappCategory       @relation(fields: [categoryId], references: [id])
  categoryId  String
  isPopular   Boolean            @default(false)
  isSponsor   Boolean            @default(false)
  isHighlight Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  // Generalized visual-styling tokens (Appearance contract v1). Replaces
  // the old flat `bgColor`; banners/categories carry the same shape.
  appearance  Json?
  sortOrder   Int                @default(0)
  favorites   UserDappFavorite[]
  promotions  DappPromotion[]

  @@index([categoryId])
  @@index([isPopular])
  @@index([isSponsor])
  @@index([isHighlight])
  @@index([isActive])
  @@index([createdAt])
  @@index([sortOrder])
}

model UserDappFavorite {
  id        String   @id @default(ulid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  dapp      Dapp     @relation(fields: [dappId], references: [id])
  dappId    String
  createdAt DateTime @default(now())

  @@unique([userId, dappId])
  @@index([userId])
  @@index([dappId])
}

// Editorial banners for the ecosystem-hub carousel. Not 1:1 with a dapp:
// they carry their own copy/colors and can be scheduled, which is why they
// live in a dedicated table rather than reusing the `isSponsor` flag.
model DappPromotion {
  id          String    @id @default(ulid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  appearance  Json?
  targetUrl   String?
  dapp        Dapp?     @relation(fields: [dappId], references: [id])
  dappId      String?
  isSponsored Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([dappId])
}

model AddressBook {
  id        String   @id @default(ulid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String
  address   String
  ensName   String?
  notes     String?
  isEvm     Boolean  @default(true)
  chainName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address])
  @@index([userId])
  @@index([userId, label])
}

// ── Point System ────────────────────────────────────────────────────────────

model PointBalance {
  id        String   @id @default(ulid())
  userId    String   @unique
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// TimescaleDB Hypertable - optimized for high-volume point ledger
// Composite PK required for hypertable partitioning on createdAt
// Note: No FK relation to PointRedemption — TimescaleDB hypertables cannot be
// the target of FK constraints (chunks live in _timescaledb_internal).
// Referential integrity is enforced at the application level.
model PointTransaction {
  id            String               @default(ulid())
  userId        String
  type          PointTransactionType
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt

  // Deposit fields (populated for DEPOSIT type)
  // Note: refId/txHash are not @unique — TimescaleDB hypertables disallow unique
  // indexes without the partitioning column. Uniqueness enforced at app level.
  refId           String?
  txHash          String?
  tokenId         String?
  blockchainId    String?
  contractAddress String?
  tokenAmount     Decimal? @db.Decimal(36, 18)
  pointRate       Decimal? @db.Decimal(18, 8)

  // Redemption fields (populated for SPEND/REFUND type)
  referenceType String?
  referenceId   String?

  status    PointTransactionStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime               @default(now())

  user       User        @relation(fields: [userId], references: [id])
  token      Token?      @relation(fields: [tokenId], references: [id])
  blockchain Blockchain? @relation(fields: [blockchainId], references: [id])

  @@id([id, createdAt])
  @@unique([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([txHash])
  @@index([refId])
}

model PointPriceConfig {
  id        String   @id @default(ulid())
  baseRate  Decimal  @db.Decimal(18, 8)
  currency  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([currency, isActive])
  @@index([isActive, createdAt(sort: Desc)])
}

enum PointTransactionType {
  DEPOSIT
  SPEND
  REFUND
  BONUS
}

enum PointTransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
}

// Note: pointTransactionId/pointTransactionCreatedAt reference the PointTransaction
// hypertable but have no DB-level FK — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model PointRedemption {
  id                        String           @id @default(ulid())
  userId                    String
  pointTransactionId        String
  pointTransactionCreatedAt DateTime
  productVariantId          String
  productPriceId            String
  customerInfo              Json?
  status                    RedemptionStatus @default(PENDING)
  pointsSpent               BigInt
  vendorResponse            Json?
  vendorRefId               String?
  metadata                  Json?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  productPrice   ProductPrice   @relation(fields: [productPriceId], references: [id])

  @@unique([pointTransactionId, pointTransactionCreatedAt])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

enum RedemptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model FlashSale {
  id                 String   @id @default(ulid())
  productVariantId   String
  productPriceId     String
  discountedPrice    Decimal  @db.Decimal(18, 2)
  currency           String
  startsAt           DateTime
  endsAt             DateTime
  maxRedemptions     Int?
  currentRedemptions Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  productPrice   ProductPrice   @relation(fields: [productPriceId], references: [id])

  @@index([isActive, startsAt, endsAt])
  @@index([productVariantId])
}

// ── NFT Asset Management ────────────────────────────────────────────────────

enum NftTokenType {
  ERC721
  ERC1155
}

model NftAsset {
  id              String       @id @default(ulid())
  userId          String
  walletAddress   String
  contractAddress String
  tokenId         String
  blockchainId    String
  tokenType       NftTokenType @default(ERC721)
  name            String?
  description     String?
  imageUrl        String?
  tokenUri        String?
  attributes      Json?
  isOwned         Boolean      @default(true)
  lastVerifiedAt  DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  blockchain Blockchain @relation(fields: [blockchainId], references: [id])

  @@unique([walletAddress, contractAddress, tokenId, blockchainId])
  @@index([userId, isOwned])
  @@index([contractAddress])
  @@index([blockchainId])
}

// ── UMKM USDC Payout Rails (§6.6) ───────────────────────────────────────────
// Persistence for the scan-QRIS → USDC Nanopay → Xendit IDR disbursement
// pipeline. Column names and semantics follow umkm-usdc-payout-spec.md §6.6
// verbatim — the on-wire API shape (§6) is the canonical contract.

enum PaymentIntentStatus {
  QUOTED
  SIGNED
  SETTLED
  PAID_OUT
  FAILED
  EXPIRED
}

enum PaymentIntentPath {
  nanopay
  x402
  direct_arc
  takumipay
}

enum GaslessMode {
  nanopay
  arc_native
  x402_eip3009
  none
}

enum ProviderPayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GatewayDepositStatus {
  PENDING_ATTESTATION
  CONFIRMED
  FAILED
}

enum ChannelKind {
  ewallet
  bank
}

enum QrisClaimDisputeStatus {
  none
  open
  resolved_valid
  resolved_invalid
}

model Merchant {
  id                      String    @id @default(ulid())
  user                    User?     @relation(fields: [userId], references: [id])
  userId                  String?   @unique
  displayName             String
  contactPhone            String
  country                 String    @db.Char(2)
  payoutChannelCode       String
  // Encrypted at rest via the repo's existing envelope helper. BYTEA in Postgres.
  payoutAccountNumber     Bytes
  payoutAccountHolderName String
  qrisPan                 String?
  qrisStickerPhotoKey     String?
  jwsQr                   String
  jwsIssuedAt             DateTime  @db.Timestamptz()
  jwsExpiresAt            DateTime? @db.Timestamptz()
  isActive                Boolean   @default(true)
  payoutProvider          String    @default("xendit")
  createdAt               DateTime  @default(now()) @db.Timestamptz()
  updatedAt               DateTime  @updatedAt @db.Timestamptz()

  paymentIntents PaymentIntent[]
  qrisClaims     MerchantQrisClaim[]

  // NOTE: the partial unique index on qrisPan (WHERE qrisPan IS NOT NULL) is
  // defined in the migration SQL — Prisma's @@index / @@unique cannot express
  // partial predicates. Do not add @@index([qrisPan]) here; the partial unique
  // is sufficient for lookups and enforces first-claim-wins.
}

model PaymentIntent {
  id                         String              @id @default(ulid())
  payer                      User?               @relation("PaymentIntentPayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  payerUserId                String?
  merchant                   Merchant            @relation(fields: [merchantId], references: [id])
  merchantId                 String
  fiatAmountMinor            Int
  fiatCurrency               String
  nanopayUsdcAmountMicros    BigInt?
  nanopayUsdcSourceChainId   Int?
  nanopayUsdcTreasuryAddress String?
  // Onchain settlement — multi-token + fee fields (Phase 1)
  sourceToken                Token?              @relation(fields: [sourceTokenId], references: [id])
  sourceTokenId              String?
  platformFeeAmountMinor     BigInt?
  merchantBackingAmountMinor BigInt?
  platformFeeBpsSnapshot     Int?
  quoteSignature             Bytes?
  // Audit trail — references the `exchange_rates` hypertable; FK omitted
  // because TimescaleDB hypertables cannot be FK targets (see CLAUDE.md).
  // Composite (id + createdAt) is mirrored on the snapshot columns below so
  // application-level lookups can locate the source row.
  exchangeRateId             Int
  exchangeRateCreatedAt      DateTime            @db.Timestamptz()
  fxRateSnapshot             Decimal             @db.Decimal(36, 18)
  fxMarkupSnapshot           Decimal             @db.Decimal(36, 18)
  fxFromCurrency             String
  fxToCurrency               String
  fxProvider                 String
  fxQuotedAt                 DateTime            @db.Timestamptz()
  feesNetworkUsdMicros       Int
  // Payout-side fee snapshot at intent-creation time. Integer minor-units
  // of the intent's `fiatCurrency` (IDR rupiah today; PHP centavos / THB
  // satang when other countries land — currency lives on `fiatCurrency`,
  // not in the column name). Was `feesXenditIdr` until the rename made
  // the schema provider/currency-agnostic.
  feesPayoutMinor            Int
  feesPlatformBps            Int
  path                       PaymentIntentPath
  nanopayNonce               Bytes               @unique
  nanopayValidAfter          Int
  nanopayValidBefore         Int
  gaslessMode                GaslessMode
  requiresDeposit            Boolean
  status                     PaymentIntentStatus @default(QUOTED)
  createdAt                  DateTime            @default(now()) @db.Timestamptz()
  updatedAt                  DateTime            @updatedAt @db.Timestamptz()
  expiresAt                  DateTime            @db.Timestamptz()

  nanopaySubmissions NanopaySubmission[]
  // payouts are audit-permanent; deleting an intent must NOT cascade to them.
  payouts            ProviderPayout[]
  onchainSettlements OnchainSettlement[]

  @@index([status, expiresAt])
  @@index([merchantId, createdAt(sort: Desc)])
}

model NanopaySubmission {
  id                             String        @id @default(ulid())
  intent                         PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  intentId                       String
  signature                      Bytes
  submittedAt                    DateTime      @db.Timestamptz()
  circleSettleTxUuid             String?       @db.Uuid
  circleSettleResponseReceivedAt DateTime?     @db.Timestamptz()
  circleSettleNetwork            String?
  failureCode                    String?
  failureMessage                 String?

  @@index([intentId])
}

model ProviderPayout {
  id                     String               @id @default(ulid())
  // onDelete: Restrict — payouts are audit-permanent; an intent must not be
  // deletable while a payout row references it (§6.6 audit guarantees).
  intent                 PaymentIntent        @relation(fields: [intentId], references: [id], onDelete: Restrict)
  intentId               String
  // Which provider handled this disbursement. Audit-permanent — stays correct
  // even if the merchant later switches `payoutProvider`.
  provider               String
  providerPayoutId       String?
  referenceId            String
  channelCode            String
  accountNumberEncrypted Bytes
  amount                 Int
  currency               String
  status                 ProviderPayoutStatus @default(PENDING)
  // Provider-specific response code (e.g. Duitku "00" / "TO" / "68" / "-100").
  // Null for Xendit rows. Drives retry/reconcile discipline for Duitku.
  providerResponseCode   String?
  requestedAt            DateTime?            @db.Timestamptz()
  completedAt            DateTime?            @db.Timestamptz()
  webhookReceivedAt      DateTime?            @db.Timestamptz()
  providerResponseBody   Json?
  createdAt              DateTime             @default(now()) @db.Timestamptz()
  updatedAt              DateTime             @updatedAt @db.Timestamptz()

  @@index([intentId])
  @@index([provider, status])
}

model GatewayDeposit {
  id                  String               @id @default(ulid())
  user                User                 @relation(fields: [userId], references: [id])
  userId              String
  sourceChainId       Int
  // Unique — task 38 uses txHash as the natural idempotency key for
  // `POST /v1/pay/intents/:id/deposit-receipt`. A replay returns the
  // existing row without creating a duplicate audit entry (spec §6.6).
  txHash              String               @unique
  amountMicros        BigInt
  usedCirclePaymaster Boolean
  status              GatewayDepositStatus @default(PENDING_ATTESTATION)
  createdAt           DateTime             @default(now()) @db.Timestamptz()
  confirmedAt         DateTime?            @db.Timestamptz()

  @@index([userId, status])
}

model Channel {
  channelCode   String      @db.Text
  country       String      @db.Char(2)
  label         String
  kind          ChannelKind
  accountFormat String
  priority      Int
  isActive      Boolean     @default(true)
  iconUrl       String?
  createdAt     DateTime    @default(now()) @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @db.Timestamptz()

  providerChannels ProviderChannel[]

  @@id([channelCode, country])
  @@index([country, isActive, priority])
}

// Per-provider mapping + fee schedule for a canonical `Channel`. Adding a
// new payout provider means inserting rows here (two per channel: "xendit"
// + "<new>"), not adding columns on `Channel`. Adapters resolve the wire
// code (e.g. Duitku "014" for BCA) via `providerChannelCode`.
model ProviderChannel {
  id                  String   @id @default(ulid())
  channel             Channel  @relation(fields: [channelCode, country], references: [channelCode, country])
  channelCode         String
  country             String   @db.Char(2)
  provider            String
  providerChannelCode String
  minAmountIdr        Int?
  maxAmountIdr        Int?
  feeIdr              Int
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @updatedAt @db.Timestamptz()

  @@unique([channelCode, country, provider])
  @@index([provider, isActive])
}

model MerchantQrisClaim {
  id              String                 @id @default(ulid())
  merchant        Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId      String
  qrisPan         String
  stickerPhotoKey String
  claimedAt       DateTime               @db.Timestamptz()
  reviewedAt      DateTime?              @db.Timestamptz()
  disputeStatus   QrisClaimDisputeStatus @default(none)
  createdAt       DateTime               @default(now()) @db.Timestamptz()
  updatedAt       DateTime               @updatedAt @db.Timestamptz()

  @@index([qrisPan])
}

// ── Onchain Settlement (Phase 1) ───────────────────────────────────────────

model OnchainSettlement {
  id             String        @id @default(ulid())
  intent         PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  intentId       String
  txHash         String
  chainId        Int?
  cluster        String?
  confirmations  Int?
  verifiedAt     DateTime?     @db.Timestamptz()
  failureCode    String?
  failureMessage String?
  createdAt      DateTime      @default(now()) @db.Timestamptz()

  @@unique([intentId, txHash])
  @@index([txHash])
}

model UserStrategy {
  id                String             @id @default(cuid())
  userId            String
  walletAddress     String // lowercased
  namespace         String // "eip155" | "solana" | "sui"
  tier              String // "conservative" | "balanced" | "aggressive"
  assetPreferences  String[] // multi-select: any subset of "stable" | "eth_lst" | "multi"
  liquidityPref     String // "instant" | "7d" | "30d"
  chainPref         Json // ["any"] or [1, 8453, 42161]
  allocationPct     Int // 10/25/50/custom
  rebalanceTrigger  Json // { kind: "interval", value: "weekly" } | { kind: "yield_drop", thresholdBps: 150 }
  protocolWhitelist String[] // ["aave-v3","lido","curve-3pool"] — empty MEANS "use curated default" (see §21.2), NOT "any protocol in tier"
  allowAllInTier    Boolean            @default(false) // §21.2 — opt-out of curation; when true an empty protocolWhitelist means "any protocol in tier"
  autoCompound      Boolean            @default(false) // §21.3 — opt-in: when true, claimed rewards are redeposited into the same position via `defi_compound`. Still human-in-the-loop (one signature per cycle); no AA.
  notificationLevel String // "every" | "daily" | "alerts"
  activatedAt       DateTime?
  pausedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  positions         StrategyPosition[]

  @@index([userId])
  @@index([walletAddress])
}

model StrategyPosition {
  id                 String    @id @default(cuid())
  userStrategyId     String
  walletAddress      String // lowercased
  chainId            Int // 0 for non-EVM; carry namespace + slug below
  namespace          String
  chainName          String    @default("") // copied from the source OpportunityCache row at create time; mirrors DeFiLlama's `chain` value
  protocolSlug       String // "aave-v3" | "lido" | "morpho" | ...
  assetSymbol        String // "USDC" | "ETH" | ...
  assetContract      String? // lowercased, null for native
  poolId             String? // DeFiLlama poolId the position was opened against (pool-level deposits spec §4.2) — pins the exact sibling pool, null for legacy positions opened before pool-level routing
  amountAtDeposit    String // raw units (decimal string for bigint)
  amountAtDepositUsd Decimal // snapshotted USD value at deposit
  currentAmountRaw   String? // last observed
  currentAmountUsd   Decimal? // last observed
  status             String // "active" | "withdrawn" | "failed"
  openTxHash         String?
  closeTxHash        String?
  openedAt           DateTime
  closedAt           DateTime?

  // §14.6 — goal tracking. Both optional; set when the LLM extracts a
  // goal+horizon from the user's natural-language request
  // ("I want to use it later to buy a laptop after 3 months" → goal:
  // "Laptop purchase", targetDate: now+90d). Surfaced in the
  // PositionListCard countdown. Drives the goal-deadline-watcher
  // worker (§18) that nudges the user when targetDate is near or past.
  goal       String?
  targetDate DateTime?

  userStrategy UserStrategy @relation(fields: [userStrategyId], references: [id])

  @@index([walletAddress, status])
  @@index([targetDate]) // goal-deadline-watcher scans by date
}

model OpportunityCache {
  id                   String   @id @default(cuid())
  protocolSlug         String
  chainId              Int // 0 for non-EVM (carry namespace below)
  namespace            String
  chainName            String   @default("") // DeFiLlama's `chain` field, e.g. "Ethereum", "Arbitrum", "Base", "Solana"
  assetSymbol          String
  assetContract        String? // ERC-20 / SPL mint / Sui coin type the protocol's underlying reserve uses; null when not resolvable (e.g. mainnet defillama-scored rows that need a later resolver pass)
  poolId               String // DeFiLlama pool id
  poolMeta             String? // DeFiLlama vault/market name or fee tier ("Steakhouse USDC", "0.05%") — disambiguates sibling pools sharing (protocol, asset, chain). Free-text label, never an address. (pool-level deposits spec §4.2)
  depositTarget        Json? // resolved DepositTarget discriminated union (spec §4.1); null = unresolved → the row degrades to the "manual" deep-link path. Written by the PoolTargetResolver registry at score time.
  targetResolvedAt     DateTime? // when depositTarget was last resolved + on-chain validated; drives periodic re-validation
  apy                  Decimal
  apy7dAvg             Decimal
  apyStddev30d         Decimal
  tvlUsd               Decimal
  tvl7dDelta           Decimal
  emissionsToFeesRatio Decimal?
  ilExposure           Boolean // true if pool can experience IL
  score                Int // 0–100 composite
  tier                 String // "conservative" | "balanced" | "aggressive"
  raw                  Json // upstream payload for debugging
  scoredAt             DateTime

  @@unique([poolId])
  @@index([tier, score])
}

model ProtocolScoreCache {
  protocolSlug       String   @id
  safetyScore        Int // 0–100 protocol-safety dimension (slow-moving)
  auditCount         Int
  protocolAgeDays    Int
  exploitHistoryFlag Boolean
  tvlTrendBps        Int // signed; 7d trend in bps
  appUrl             String? // DeFiLlama /protocol/{slug}.url — the protocol's own app URL, used as the manual deep-link homepage fallback (pool-level deposits spec §9.1). Protocol-scoped so it isn't duplicated per-pool.
  computedAt         DateTime
}

// Spec §18 — goal-deadline-watcher dedup marker. Each (positionId, kind)
// pair gets one row when the worker emits a nudge; subsequent runs skip
// the position when the marker is present and recent. `kind` is the
// event name: `defi.goal.approaching` (7-day warning) or
// `defi.goal.reached` (target date hit).
model StrategyPositionEvent {
  id         String   @id @default(cuid())
  positionId String
  kind       String
  emittedAt  DateTime @default(now())

  @@unique([positionId, kind])
  @@index([positionId])
}
