// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  SUBCATEGORY
  MAINCATEGORY
}

model Category {
  id             String           @id @default(ulid())
  name           String           @unique
  description    String?
  imageUrl       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Product        Product[]
  categoryType   CategoryType
  ProductVariant ProductVariant[]
}

model Product {
  id          String              @id @default(ulid())
  name        String
  description String?
  imageUrl    String?
  code        String              @unique
  category    Category            @relation(fields: [categoryId], references: [id])
  categoryId  String
  isActive    Boolean             @default(true)
  isVoucher   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  variants    ProductVariant[]
  inputFields ProductInputField[]

  @@index([code])
}

enum InputFieldType {
  TEXT
  NUMBER
  EMAIL
  OPTION
  DATE
}

model ProductInputField {
  id        String   @id @default(ulid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  forms     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id            String         @id @default(ulid())
  name          String
  description   String?
  variantCode   String         @unique
  product       Product        @relation(fields: [productId], references: [id])
  productId     String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ProductPrice  ProductPrice[]
  Purchase      Purchase[]
  BookingOrder  BookingOrder[]
  subCategory   Category?      @relation(fields: [subCategoryId], references: [id])
  subCategoryId String?

  @@index([variantCode])
}

model Vendor {
  id           String         @id @default(ulid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  VendorAPI    VendorAPI[]
  ProductPrice ProductPrice[]
}

model User {
  id            String               @id @default(ulid())
  walletAddress String?              @unique
  email         String?              @unique
  username      String?              @unique
  password      String?
  name          String?
  profileImage  String?
  authProvider  AuthProvider
  socialId      String?
  role          UserRole             @default(USER)
  status        UserStatus           @default(ACTIVE)
  permissions   Json?
  lastLoginAt   DateTime?
  loginAttempts Int                  @default(0)
  lockedUntil   DateTime?
  transactions  TransactionHistory[]
  apiLogs       ApiRequestLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  Region        Region?              @relation(fields: [regionId], references: [id])
  regionId      String?
  ApiKey        ApiKey[]
  auditLogs     AdminAuditLog[]
  dappFavorites UserDappFavorite[]

  @@unique([authProvider, socialId])
  @@index([role])
  @@index([status])
  @@index([email])
  @@index([username])
}

model Blockchain {
  id            String          @id @default(ulid())
  name          String          @unique
  chainId       Int             @unique
  rpcUrl        String
  blockExplorer String
  isEVM         Boolean         @default(true)
  isActive      Boolean         @default(true)
  tokens        Token[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  SmartContract SmartContract[]
  isTestnet     Boolean         @default(false)
}

model Token {
  id                 String                 @id @default(ulid())
  name               String
  symbol             String
  decimals           Int
  blockchain         Blockchain             @relation(fields: [blockchainId], references: [id])
  blockchainId       String
  contractAddress    String?                @unique
  logoUrl            String?
  isStablecoin       Boolean                @default(false)
  isActive           Boolean                @default(true)
  isNativeCurrency   Boolean                @default(false)
  transactions       TransactionHistory[]
  regionAvailability RegionAvailableToken[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([blockchainId, contractAddress])
}

model ProductPrice {
  id               String         @id @default(ulid())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  vendorId         String
  realValue        Decimal
  priceFromVendor  Decimal
  sellPrice        Decimal
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  BookingOrder     BookingOrder[]
  currency         String
}

model TransactionHistory {
  id               String            @id @default(ulid())
  user             User              @relation(fields: [userId], references: [id])
  userId           String
  token            Token             @relation(fields: [tokenId], references: [id])
  tokenId          String
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal
  amountInFiat     Decimal?
  fiatCurrency     String?
  txHash           String?
  senderAddress    String?
  recipientAddress String?
  purchase         Purchase?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Purchase {
  id                   String             @id @default(ulid())
  transaction          TransactionHistory @relation(fields: [transactionId], references: [id])
  transactionId        String             @unique
  productVariant       ProductVariant     @relation(fields: [productVariantId], references: [id])
  productVariantId     String
  bookingOrder         BookingOrder       @relation(fields: [bookingOrderId], references: [id])
  bookingOrderId       String             @unique
  status               PurchaseStatus     @default(PENDING)
  vendorResponse       Json?
  vendorStatusResponse Json?
  vendorRefId          String?
  refId                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([refId])
}

// TODO: find a better way to store the api request log
model ApiRequestLog {
  id           String   @id @default(ulid())
  requestId    String   @unique
  endpoint     String
  method       String
  service      String
  requestBody  Json
  responseBody Json?
  statusCode   Int?
  success      Boolean
  errorMessage String?
  duration     Int
  ipAddress    String?
  userAgent    String?
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  metadata     Json?
  createdAt    DateTime @default(now())
  ApiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id])
  apiKeyId     String?
}

// TODO: for better performance, we can use timescaledb to store the exchange rate
model ExchangeRate {
  id               Int            @default(autoincrement())
  fromCurrency     String
  toCurrency       String
  rate             Decimal
  sourceProvider   ExchangeSource @relation(fields: [sourceProviderId], references: [id])
  sourceProviderId String
  region           String?
  provider         String?
  markup           Decimal?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@id([id, createdAt])
  @@unique([fromCurrency, toCurrency, region, provider, createdAt])
}

model ExchangeSource {
  id             String         @id @default(ulid())
  name           String         @unique
  description    String?
  apiEndpoint    String?
  apiKey         String?
  updateInterval Int            @default(3600)
  priority       Int            @default(1)
  isActive       Boolean        @default(true)
  lastUpdated    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exchangeRates  ExchangeRate[]
}

model VendorAPI {
  id        String   @id @default(ulid())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  vendorId  String
  baseUrl   String
  apiKey    String
  apiSecret String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmartContract {
  id           String      @id @default(ulid())
  name         String
  blockchain   Blockchain  @relation(fields: [blockchainId], references: [id])
  blockchainId String
  address      String
  abi          ContractABI @relation(fields: [abiId], references: [id])
  abiId        String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([blockchainId, address])
}

model ContractABI {
  id          String          @id @default(ulid())
  name        String          @unique
  description String?
  version     String?
  abi         Json
  isVerified  Boolean         @default(false)
  contracts   SmartContract[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
  REFUNDED
  TRANSFERRED
}

enum PurchaseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuthProvider {
  WALLET
  GOOGLE
  APPLE
  EMAIL
  ADMIN_CREDENTIALS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Region {
  id                String   @id @default(ulid())
  code              String   @unique
  name              String
  currencyCode      String
  isActive          Boolean  @default(true)
  hasKYCRequirement Boolean  @default(false)
  taxRate           Decimal  @default(0)
  supportEmail      String?
  supportPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users           User[]
  availableTokens RegionAvailableToken[]
}

model RegionAvailableToken {
  id                 String   @id @default(ulid())
  region             Region   @relation(fields: [regionId], references: [id])
  regionId           String
  token              Token    @relation(fields: [tokenId], references: [id])
  tokenId            String
  isActive           Boolean  @default(true)
  minAmount          Decimal?
  maxAmount          Decimal?
  processingFee      Decimal  @default(0)
  networkFeeEstimate Decimal?
  isDefault          Boolean  @default(false)
  regulatoryNotes    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([regionId, tokenId])
}

enum BookingStatus {
  PENDING
  EXPIRED
  EXECUTED
  CANCELLED
}

enum ReferenceIdStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReferenceId {
  id        String            @id @default(ulid())
  refId     String            @unique
  status    ReferenceIdStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([refId])
  @@index([status])
}

model BookingOrder {
  id               String         @id @default(ulid())
  walletAddress    String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  productPrice     ProductPrice   @relation(fields: [productPriceId], references: [id])
  productPriceId   String
  customerInfo     Json?
  payment          Json
  exchangeRate     Json
  status           BookingStatus  @default(PENDING)
  expiresAt        DateTime
  purchase         Purchase?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([walletAddress])
  @@index([status])
}

enum ApiKeyType {
  SMART_CONTRACT
  MOBILE_APP
  WEB_APP
  THIRD_PARTY
  INTERNAL
  ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id          String          @id @default(ulid())
  name        String
  description String?
  keyValue    String          @unique
  type        ApiKeyType
  status      ApiKeyStatus    @default(ACTIVE)
  permissions Json?
  rateLimit   Int?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int             @default(0)
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdById String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  apiLogs     ApiRequestLog[]

  @@index([keyValue])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(ulid())
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  adminUserId String
  action      String
  resource    String
  resourceId  String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model DappCategory {
  id          String   @id @default(ulid())
  name        String   @unique
  description String?
  iconUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dapps       Dapp[]

  @@index([name])
  @@index([isActive])
}

model Dapp {
  id          String             @id @default(ulid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String
  category    DappCategory       @relation(fields: [categoryId], references: [id])
  categoryId  String
  isPopular   Boolean            @default(false)
  isSponsor   Boolean            @default(false)
  isHighlight Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  bgColor     String?
  favorites   UserDappFavorite[]

  @@index([categoryId])
  @@index([isPopular])
  @@index([isSponsor])
  @@index([isHighlight])
  @@index([isActive])
  @@index([createdAt])
}

model UserDappFavorite {
  id        String   @id @default(ulid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  dapp      Dapp     @relation(fields: [dappId], references: [id])
  dappId    String
  createdAt DateTime @default(now())

  @@unique([userId, dappId])
  @@index([userId])
  @@index([dappId])
}
