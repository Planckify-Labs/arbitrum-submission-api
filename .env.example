DATABASE_URL=postgresql://takumipay:takumipay-123@localhost:5432/takumipay
PORT=4000
VCGAMERS_SECRET=

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_TIME=90D
REFRESH_TOKEN_EXPIRATION_TIME=200D
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

NONCE_EXPIRE_TIME_MINUTES=5
SIWE_DOMAIN="com.cstralpt.takumipay"
SIWE_URI="takumipay://wallet-auth"
SIWE_STATEMENT="Sign in to TakumiPay Mobile App"

CHAIN_ID=1
MIN_CONFIRMATIONS=12

VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_REQUEST_TIMEOUT=5000

# Security & CORS
CORS_ORIGINS=http://localhost:3000,https://app.takumipay.com,takumipay://
CORS_CREDENTIALS=true
MAX_REQUEST_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BOOKING_RATE_LIMIT_WINDOW_MINUTES=15
BOOKING_RATE_LIMIT_MAX_REQUESTS=10

# Google OAuth
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# NATS (optional — pub/sub for cross-pod cache invalidation)
NATS_SERVERS=nats://your-nats-host:4222
NATS_USER=
NATS_PASS=

# TakumiPay signed-QR signing key (ES256 / P-256 PEM, PKCS#8 or SEC1).
# Multi-line PEM with literal \n escapes OR the full BEGIN/END block.
# This is the PRIVATE half of the EXPO_PUBLIC_TAKUMIPAY_QR_PUBKEY_JWK bundled in mobile.
# NEVER commit, NEVER mirror to takumi-agent-api, NEVER ship under any EXPO_PUBLIC_* prefix.
# Rotated via scripted key gen + EAS OTA (spec §4.4 final paragraph; ops task 50).
TAKUMIPAY_QR_PRIVATE_KEY_PEM=

# TakumiPay QR JWS `kid` (JOSE header key-id). Bumped in lockstep with the
# EXPO_PUBLIC_TAKUMIPAY_QR_PUBKEY_JWK rotation. Default: 2026-04-20.
TAKUMIPAY_QR_KID=2026-04-20

# NOTE: TAKUMIPAY_QR_EXP_DAYS has been removed. QRs no longer expire —
# revocation is handled server-side via merchant.isActive at intent-creation
# time. JWS signature proves authenticity; the server decides whether to
# honor the merchant.

# Circle Gateway x402 supported URL (spec §6.5, task 22).
# Backend fetches this at boot + every 12 h and caches under key `x402:supported`
# in Valkey (24 h TTL) + in-memory for hot-path EIP-712 domain lookups.
# Use the testnet URL for staging, the prod URL for mainnet.
#   testnet: https://gateway-api-testnet.circle.com/gateway/v1/x402/supported
#   prod:    https://gateway-api.circle.com/gateway/v1/x402/supported
CIRCLE_X402_SUPPORTED_URL=https://gateway-api-testnet.circle.com/gateway/v1/x402/supported

# Optional Circle Developer Console API key. When set, the settle proxy
# attaches `Authorization: Bearer ${CIRCLE_API_KEY}` to the request so the
# transfer shows up in the Console attestation history. NEVER commit a
# real key to source control — generate per-environment via `app.circle.com`.
#
# NOTE: The facilitator settle URL (previously `CIRCLE_GATEWAY_API` +
# hardcoded path for EVM, `CIRCLE_X402_SVM_FACILITATOR_URL` for SVM) is now
# stored per-chain in `Blockchain.x402FacilitatorUrl`. Configure via seed/SQL:
#   UPDATE "Blockchain"
#      SET "x402FacilitatorUrl" = 'https://gateway-api-testnet.circle.com/gateway/v1/x402/settle'
#    WHERE "chainSlug" = 'arc-testnet';
CIRCLE_API_KEY=

# Default payout provider for new merchants and pre-signup channel listing.
# Valid values: xendit | duitku | flip
DEFAULT_PAYOUT_PROVIDER=duitku

# Xendit disbursement / payout provider (task 29, spec §6.4).
# `XENDIT_API_BASE` points at Xendit's REST root — the `/v2/payouts` path
# is appended by `XenditPayoutProvider`. Keep the default unless you're
# routing through a corporate proxy.
XENDIT_API_BASE=https://api.xendit.co

# Xendit secret key — used as HTTP Basic username with an empty password
# (`Authorization: Basic base64(KEY:)`). Format `xnd_development_…` for
# sandbox, `xnd_production_…` for live. NEVER commit a real key, NEVER
# mirror to mobile, NEVER log (redaction is enforced in
# `XenditPayoutProvider`).
XENDIT_SECRET_KEY=

# Static `x-callback-token` issued by Xendit when the webhook URL is
# registered. Consumed by task 30 (`POST /webhooks/xendit`) for signature
# verification via `XenditPayoutProvider.verifyWebhookSignature`. NEVER
# commit a real value — rotate by re-registering the callback URL in the
# Xendit dashboard.
XENDIT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Duitku disbursement (Online Transfer: RTOL + e-wallet)
# Research ref: docs/duitku_payout_provider_research.md §2, §5
# ---------------------------------------------------------------------------
# Integer merchant id issued by Duitku after disbursement activation.
DUITKU_DISB_USER_ID=
# Registered merchant email. Also the second identifier in every signature.
DUITKU_DISB_EMAIL=
# Opaque shared secret (SHA256 HMAC material). Emailed by Duitku after
# activation. NEVER commit, NEVER log (redaction enforced in the adapter).
DUITKU_DISB_SECRET_KEY=
# API base. Sandbox for dev, `https://passport.duitku.com/webapi/api/disbursement`
# for prod. The adapter appends `/inquiry`, `/transfer`, `/inquirystatus`
# (and their sandbox variants) per §2.2 / §2.3.
DUITKU_DISB_API_BASE=https://sandbox.duitku.com/webapi/api/disbursement

# ---------------------------------------------------------------------------
# Flip Business disbursement (Money Transfer API v2)
# Spec ref: docs/flip_payout_provider_spec.md §2.1, §2.2, §4.8
# ---------------------------------------------------------------------------
# Secret key from Flip for Business dashboard. Used as HTTP Basic Auth
# username with empty password (`Authorization: Basic base64(KEY:)`).
# NEVER commit a real key, NEVER log (redaction enforced in the adapter).
FLIP_SECRET_KEY=
# Webhook validation token from Flip dashboard. Sent by Flip in callback
# bodies as the `token` field. Verified via constant-time comparison.
# NEVER commit a real value.
FLIP_VALIDATION_TOKEN=
# API base URL. Sandbox for dev, `https://bigflip.id/api/v2` for prod.
# The adapter appends `/disbursement`, `/general/balance`, etc.
FLIP_API_BASE=https://bigflip.id/big_sandbox_api/v2

# ---------------------------------------------------------------------------
# ERC-4337 bundler URLs (task 37 — `POST /v1/userop/submit`, spec §6.7, §10)
# ---------------------------------------------------------------------------
# Bundler URLs are NOT env-configured — they live in the `Blockchain.bundlerUrl`
# column (see `prisma/schema.prisma`), resolved per-chain by `UserOpService`
# with a short in-process cache. Ops seeds each supported chain via SQL:
#
#     UPDATE "Blockchain"
#        SET "bundlerUrl" = 'https://api.pimlico.io/v2/base/rpc?apikey=<KEY>'
#      WHERE "chainId"    = 8453;
#
# A NULL `bundlerUrl` is the allowlist signal: requests for that chainId are
# rejected 400 `CHAIN_NOT_SUPPORTED`. Mobile never sees these URLs — the
# adapter (task 35) signs UserOps locally and POSTs to `/v1/userop/submit`.
#
# The column currently carries the provider API key in the query string. The
# planned split (URL-clean-of-key in DB + key in a secrets manager, joined
# at request time with `Authorization: Bearer`) is tracked in
# `docs/security_review_needed.md §4`.

# ---------------------------------------------------------------------------
# Path B-SVM — Solana x402 facilitator (task 43, spec §5.2.1, §10, §12 Q7)
# ---------------------------------------------------------------------------
# PLATFORM_TREASURY_ADDRESS_SVM — platform-owned Solana keypair (base58 pubkey)
# that receives USDC-SPL as the `payTo` for every Solana Nanopay intent.
# Paired with SVM_SETTLER_PRIVATE_KEY (below — ops only, never committed, never
# mirrored to mobile under any EXPO_PUBLIC_* prefix). May be BLANK until M6 —
# the pay module tolerates absence and the SVM rail simply returns a typed
# 503 on create-intent until both envs are filled in. See spec §5.2.1 for
# the USDC ATA bootstrap runbook.
PLATFORM_TREASURY_ADDRESS_SVM=
SVM_SETTLER_PRIVATE_KEY=


# NOTE: CIRCLE_X402_SVM_FACILITATOR_URL has been removed. The SVM facilitator
# URL is now stored in `Blockchain.x402FacilitatorUrl` alongside EVM chains.
# Configure via seed/SQL:
#   UPDATE "Blockchain"
#      SET "x402FacilitatorUrl" = 'https://gateway-api-testnet.circle.com/gateway/v1/x402/settle'
#    WHERE "chainSlug" = 'solana-mainnet';

# ---------------------------------------------------------------------------
# Onchain Settlement Rail (task 18-32, spec §4.4, §4.7a, §4.8, §4.9, §8)
# ---------------------------------------------------------------------------
# Default settlement rail for new intents when the intent's `path` column is
# not explicitly set. Valid values: nanopay | takumipay
PAYMENT_SETTLEMENT_RAIL=takumipay
# Per-rail confirmation override for onchain settlement. When set, overrides
# the global MIN_CONFIRMATIONS for the onchain rail only. Leave blank to
# fall back to MIN_CONFIRMATIONS (default 12).
ONCHAIN_MIN_CONFIRMATIONS=
# 0x-prefixed 66-char EIP-712 signer key used to sign quote commitments for
# the TakumiWalletMerchant contract (EVM chains).
EVM_QUOTE_SIGNER_PRIVATE_KEY=0x5d9e91e278a1c6f4bca13e7675240825829c5cdc9d68ce71e9b10701d810bdc3
# TTL in seconds for direct_arc quotes. Default 900 (15 min). The intent's
# expiresAt is set to now() + this value at quote time.
QUOTE_TTL_DIRECT_ARC_SECONDS=900
# EIP-712 domain name used by the TakumiWalletMerchant contract's
# processMerchantPayment signature verification.
QUOTE_SIGNATURE_DOMAIN_NAME=TakumiPay
# EIP-712 domain version — must match the contract's constructor arg.
QUOTE_SIGNATURE_DOMAIN_VERSION=1

# ---------------------------------------------------------------------------
# DeFi Strategies Phase 1
# ---------------------------------------------------------------------------
# API keys
ZERION_API_KEY=
DEBANK_API_KEY=
# DeFiLlama key is optional — public endpoints work without one.
DEFILLAMA_API_KEY=
# LI.FI key is optional — public endpoints work without one (rate-limited).
LIFI_API_KEY=
# LI.FI integrator name (attribution string, NOT a secret). Defaults to
# "takumipay" when unset; set to your prod app name when you ship.
LIFI_INTEGRATOR=takumipay

# Worker toggles & budgets
DEFI_WORKERS_ENABLED=true
DEFI_STABLECOIN_DEPEG_THRESHOLD_BPS=50
DEFI_ZERION_DAILY_BUDGET_REQUESTS=1000
DEFI_DEBANK_DAILY_BUDGET_CENTS=500
# Days between auto-compound nudges per position (spec §21.3). The
# watcher cron fires daily, but its per-bucket dedup means each user
# only sees one push per window. Default 7.
DEFI_AUTO_COMPOUND_INTERVAL_DAYS=7

# Base URLs (REQUIRED — services fail loudly at startup if missing).
# Override these only if you proxy these endpoints or use a non-default host.
DEFILLAMA_YIELDS_URL=https://yields.llama.fi
DEFILLAMA_API_URL=https://api.llama.fi
# Only required when DEFILLAMA_API_KEY is also set (free tier ignores this).
DEFILLAMA_PRO_URL=https://pro-api.llama.fi
LIFI_API_URL=https://li.quest/v1
ZERION_API_URL=https://api.zerion.io/v1
DEBANK_API_URL=https://api.cloud.debank.com/v1

# Operational tuning — leave unset to use the defaults shown.
# DeFiLlama: pool-poll cache TTL (seconds; should match the cron tick).
# DEFILLAMA_POOLS_CACHE_TTL_SEC=1800
# DeFiLlama: per-protocol metadata cache TTL (seconds; metadata is slow-moving).
# DEFILLAMA_PROTOCOL_CACHE_TTL_SEC=21600
# DeFiLlama: HTTP request timeout (ms) for every DeFiLlama call.
# DEFILLAMA_REQUEST_TIMEOUT_MS=20000
# DeFiLlama: skip pools below this TVL (USD) when filtering /pools.
# DEFILLAMA_MIN_TVL_USD=5000000
# DeFiLlama: cap on how many pools are scored per cron tick.
# DEFILLAMA_MAX_POOLS=100
# LI.FI: HTTP request timeout (ms).
# LIFI_REQUEST_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Push notifications (Expo Push)
# ---------------------------------------------------------------------------
# Powers the auto-compound watcher push (defi-strategies-spec.md §21.3)
# and the UMKM USDC payout receipt push (umkm-usdc-payout-spec.md §6.3).
# Leave EXPO_ACCESS_TOKEN blank to use the free anonymous relay
# (recommended for MVP — unlimited deliveries, rate-limited per source IP).
# Set an access token (https://expo.dev → account → access tokens) to
# enable enhanced-security mode and bypass per-IP rate limits.
EXPO_ACCESS_TOKEN=
