{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@generated/prisma$": "<rootDir>/../src/generated/prisma/client",
    "^@generated/(.*)$": "<rootDir>/../src/generated/$1",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
